{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "cache": {
        "key": "open-android-sdk57-native-v4",
        "paths": [
          "/home/expo/.gradle/caches/modules-2",
          "/home/expo/.gradle/wrapper",
          "/home/expo/.cache/ccache",
          "android/.gradle",
          "android/app/.cxx"
        ]
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "cache": {
        "key": "open-android-sdk57-native-v4",
        "paths": [
          "/home/expo/.gradle/caches/modules-2",
          "/home/expo/.gradle/wrapper",
          "/home/expo/.cache/ccache",
          "android/.gradle",
          "android/app/.cxx"
        ]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
