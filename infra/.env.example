# =============================================================================
# Окружение облегчённого Self-hosted Supabase + LiveKit для Open
# Для генерации всех криптографических ключей запустите:
#   node infra/generate-secrets.mjs --write
# =============================================================================

# Домены (должны смотреть A-записями на IP VPS)
API_DOMAIN=api.openger.com
LIVEKIT_DOMAIN=rtc.openger.com
SUPABASE_PUBLIC_URL=https://api.openger.com

# Приложение (схема редиректов OAuth)
SITE_URL=openger://
ADDITIONAL_REDIRECT_URLS=openger://**

# Postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=

# JWT и ключи Supabase (генерируются из JWT_SECRET скриптом generate-secrets.mjs)
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# Realtime (Phoenix secret_key_base, не менее 64 символов)
SECRET_KEY_BASE=

# Секрет воркера кластеров фрагментов (pg_cron -> Edge Function fragment-clusters)
FRAGMENT_CLUSTERS_SECRET=

# LiveKit (сигнализация, комнаты и вебхуки)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OAuth провайдеры (Google и Apple)
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
