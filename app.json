{
  "expo": {
    "name": "open",
    "slug": "open",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openger",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.openger.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.openger.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.82062890513-pgdiipj28he9vsnl6k9mdst786q237p3"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Open uses the microphone for calls, voice messages and sound for your videos. Calls in Open are public: listeners can hear you."
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Open uses the camera to take photos and record videos you send.",
          "microphonePermission": "Open uses the microphone for calls, voice messages and sound for your videos. Calls in Open are public: listeners can hear you.",
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Open needs your photo library so you can send photos and videos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Open needs your photo library so you can choose photos and videos to send."
        }
      ],
      "react-native-compressor",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Open uses the microphone for calls, voice messages and sound for your videos. Calls in Open are public: listeners can hear you.",
          "cameraPermission": "Open uses the camera to take photos and record videos you send."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleSignIn": {
        "webClientId": "82062890513-5vnh5a1ued1phadqfm187glu9rfu7boc.apps.googleusercontent.com",
        "iosClientId": "82062890513-pgdiipj28he9vsnl6k9mdst786q237p3.apps.googleusercontent.com"
      },
      "router": {},
      "eas": {
        "projectId": "3dfc2778-15a0-4d8e-a02c-4afa84e8aaa7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3dfc2778-15a0-4d8e-a02c-4afa84e8aaa7"
    }
  }
}
